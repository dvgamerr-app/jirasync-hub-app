{
  "productName": "JiraSync Hub",
  "version": "0.0.0",
  "identifier": "com.scg.wedo.jirasync-hub",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMUQyQTNEMkU3NTlCQzAKUldUQW0zVXVQU29kTzkxdk5RYXNWcWFkaXJtTDVqdlVpNEM1bjBxZmNqWUIyWjV0YTUvSno0emsK",
      "endpoints": [
        "https://github.com/dvgamerr-app/jirasync-hub-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
